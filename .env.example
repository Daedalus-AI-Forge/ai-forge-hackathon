# Written by `npx convex dev` into .env.local (never commit .env.local).
EXPO_PUBLIC_CONVEX_URL=

# Sign-in (Convex Auth: Google + native Apple). Anything other than "true"
# keeps the app anonymous-only (device identity, no sign-in UI), which is the
# safe default for the demo. See docs/auth-setup.md before turning it on.
EXPO_PUBLIC_AUTH_ENABLED=false

# Where "Get Wishwell" on the pass-on page sends people (store listing). Defaults to the web app.
EXPO_PUBLIC_APP_URL=
