{
  "expo": {
    "name": "Wishwell",
    "slug": "wishwell",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "wishwell",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.theaiforge.wishwell",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.theaiforge.wishwell",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-font",
      [
        "expo-contacts",
        {
          "contactsPermission": "Wishwell lets you pick a friend to send your paper boat to. Contacts never leave your phone."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Add a photo of you two to finish the wish, or a proof photo when you claim a boat.",
          "cameraPermission": "Add a photo of you two to finish the wish, or a proof photo when you claim a boat.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
